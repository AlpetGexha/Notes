---
import type { CollectionEntry } from "astro:content";
import RootLayout from "./RootLayout.astro";
import Tag from "@/components/Tag.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Link from "@/components/Link.astro";

interface Props {
  prompt: CollectionEntry<"prompts">;
}

const { prompt } = Astro.props;
const { title, description, tags, date, lastmod, category, versions } = prompt.data;
---

<RootLayout
  title={title}
  description={description || `AI Prompt: ${title}`}
>
  <SectionContainer>
    <article>
      <div class="xl:divide-y xl:divide-gray-200 xl:dark:divide-gray-700">
        <header class="pb-6 pt-6 xl:pb-10">
          <div class="space-y-4">
            <!-- Breadcrumb -->
            <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
              <Link href="/prompts" class="hover:text-primary-500">
                Prompts
              </Link>
              {category && (
                <>
                  <span>/</span>
                  <span class="capitalize">{category}</span>
                </>
              )}
            </div>

            <!-- Title -->
            <div>
              <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-5xl md:leading-14">
                {title}
              </h1>
            </div>

            <!-- Description -->
            {description && (
              <p class="text-xl leading-7 text-gray-500 dark:text-gray-400">
                {description}
              </p>
            )}

            <!-- Meta Info -->
            <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
              <div class="flex items-center gap-2">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <FormattedDate date={date} />
              </div>
              {lastmod && (
                <div class="flex items-center gap-2">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>Updated: <FormattedDate date={lastmod} /></span>
                </div>
              )}
              {versions && versions.length > 0 && (
                <div class="flex items-center gap-2">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                  </svg>
                  <span>v{versions[versions.length - 1].version}</span>
                </div>
              )}
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <Tag slug={tag} />
              ))}
            </div>
          </div>
        </header>

        <!-- Main Content -->
        <div class="divide-y divide-gray-200 dark:divide-gray-700 xl:col-span-3 xl:row-span-2 xl:pb-0">
          <div class="prose max-w-none pb-8 pt-10 dark:prose-invert">
            <slot />
          </div>

          <!-- Version History -->
          {versions && versions.length > 0 && (
            <div class="pt-8">
              <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-gray-100">
                Version History
              </h2>
              <div class="space-y-4">
                {versions.reverse().map((version) => (
                  <div class="border-l-4 border-primary-500 pl-4">
                    <div class="mb-2 flex items-center gap-3">
                      <span class="rounded-full bg-primary-100 px-3 py-1 text-sm font-semibold text-primary-800 dark:bg-primary-900 dark:text-primary-200">
                        v{version.version}
                      </span>
                      <span class="text-sm text-gray-500 dark:text-gray-400">
                        <FormattedDate date={version.date} />
                      </span>
                    </div>
                    <p class="text-gray-700 dark:text-gray-300">
                      {version.changes}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Actions -->
          <div class="pt-8">
            <Link
              href="/prompts"
              class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
            >
              ← Back to all prompts
            </Link>
          </div>
        </div>
      </div>
    </article>
  </SectionContainer>
</RootLayout>
