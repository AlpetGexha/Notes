---
import Link from "./Link.astro";
import { type CollectionEntry, getEntry } from "astro:content";

interface Props {
  tag?: CollectionEntry<"tags">;
  slug?: string | any; // Accept any to handle ReferenceDataEntry
}

let TagProp = Astro.props.tag;

if (!TagProp && Astro.props.slug) {
  // Convert slug to string - it might be a ReferenceDataEntry or direct string
  const slugValue = String(Astro.props.slug);
  TagProp = await getEntry("tags", slugValue);
}

if (!TagProp) {
  console.warn('Tag component: No tag data provided', Astro.props);
  return null;
}

const { slug, data } = TagProp;
---

<Link
  href={`/tags/${slug}`}
  class="mr-3 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
>
  {data.name}
</Link>
